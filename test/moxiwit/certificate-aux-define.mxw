(define-system cert_machine
   :output ((seen Bool))
   :init (not seen)
   :trans seen'
   :inv true )

(define-fun started () Bool (or (not seen) (<= 1 x_0)))

(check-system-response main
:query (qry_rch_0 :result unsat :certificate qry_rch_0_cert)
:certificate (qry_rch_0_cert
	:aux cert_machine
	(and (<= 0 x_0) started))
)
