; Binary recursion -> NONLINEAR CHC (two occurrences of fib in one body)
;   fib(0)=0, fib(1)=1, fib(n)=fib(n-1)+fib(n-2)
; property: n >= 0  =>  fib(n) >= 0     (SAFE)
(set-logic HORN)
(declare-fun fib (Int Int) Bool)
(assert (forall ((n Int) (r Int)) (=> (and (= n 0) (= r 0)) (fib n r))))
(assert (forall ((n Int) (r Int)) (=> (and (= n 1) (= r 1)) (fib n r))))
(assert (forall ((n Int) (r Int) (r1 Int) (r2 Int))
  (=> (and (>= n 2) (fib (- n 1) r1) (fib (- n 2) r2) (= r (+ r1 r2))) (fib n r))))
(assert (forall ((n Int) (r Int)) (=> (and (fib n r) (>= n 0) (< r 0)) false)))
(check-sat)
