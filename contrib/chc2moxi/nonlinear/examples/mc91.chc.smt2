; Nested recursion -> NONLINEAR CHC
;   mc91(n) = n-10 if n>100 else mc91(mc91(n+11))
; property: n <= 101 => mc91(n) = 91   (SAFE)
(set-logic HORN)
(declare-fun mc (Int Int) Bool)
(assert (forall ((n Int) (r Int)) (=> (and (> n 100) (= r (- n 10))) (mc n r))))
(assert (forall ((n Int) (r Int) (t Int))
  (=> (and (<= n 100) (mc (+ n 11) t) (mc t r)) (mc n r))))
(assert (forall ((n Int) (r Int)) (=> (and (mc n r) (<= n 101) (not (= r 91))) false)))
(check-sat)
